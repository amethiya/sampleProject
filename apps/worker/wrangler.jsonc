{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "revamp-radar",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dashboard (React build) served as static assets; API + previews handled by the Worker.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/preview/*", "/img", "/templates", "/templates/*", "/themes", "/themes/*"]
  },
  "d1_databases": [
    // Run `npx wrangler d1 create revamp-radar` and paste the returned database_id here.
    { "binding": "DB", "database_name": "revamp-radar", "database_id": "97f2b40d-3213-4783-8c7e-c9aeaf27ebd1" }
  ],
  // Night lead search: every minute 19:00–01:59 UTC; the Worker only works inside NIGHT_START–NIGHT_END
  // (19:30–01:30 UTC = 01:00–07:00 IST). Each run discovers a slice if the queue is low and audits a small batch.
  // Small batches keep each run under the free plan's 50-subrequest limit (each site: page, contact page, robots,
  // up to two sitemaps, a feed and an MX lookup).
  "triggers": { "crons": ["* 19-23,0-1 * * *"] },
  "vars": {
    "DAILY_TARGET": "10",
    "MIN_SCORE": "35",
    "BATCH_SIZE": "4",
    "ACTIVE_DAYS": "30",
    "NIGHT_START": "19:30",
    "NIGHT_END": "01:30",
    "NIGHT_TARGET": "200",
    "PUBLIC_URL": "https://revamp-radar.amethiyavivek.workers.dev",
    "SENDER_NAME": "Vivek Amethiya"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   ADMIN_TOKEN         - bearer token the dashboard uses for /api
  //   SHEETS_WEBHOOK_URL  - Google Apps Script web app URL (integrations/google-apps-script)
  //   SHEETS_SECRET       - shared secret checked by the Apps Script
}
